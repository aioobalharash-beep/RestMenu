// RestMenu database schema.
// Production target: Vercel Postgres. Set DATABASE_URL to enable the Prisma-backed
// store; without it the app falls back to a local JSON store (see src/lib/store).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  // Arabic translation (optional; falls back to English).
  nameAr    String?
  // Optional short kicker shown above the title (e.g. "To begin").
  kicker    String?
  position  Int      @default(0)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model Item {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  description   String   @default("")
  descriptionAr String?
  // Price stored in baisa (1 OMR = 1000 baisa) to avoid float rounding.
  priceBaisa    Int      @default(0)
  imageUrl      String?
  position      Int      @default(0)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId, position])
}

// ─── Ordering (optional feature) ───

model Order {
  id         String      @id @default(cuid())
  // Table label from the QR link (e.g. "12"); null for pickup/unknown.
  table      String?
  status     String      @default("new") // new | preparing | served | cancelled
  note       String?
  totalBaisa Int         @default(0)
  lines      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Snapshot of the dish at order time (survives later menu edits).
  itemId     String?
  name       String
  nameAr     String?
  priceBaisa Int     @default(0)
  quantity   Int     @default(1)

  @@index([orderId])
}
