# ─────────────────────────────────────────────────────────────
# RestMenu environment variables
# Copy to `.env` for local dev, or set these in Vercel → Settings → Environment.
# ─────────────────────────────────────────────────────────────

# Admin panel password (the owner logs in with this at /admin).
# Local dev falls back to "admin" if unset — always set a real one in production.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="generate-a-long-random-string"

# ─── Database (production) ───
# When DATABASE_URL is set, the app uses Postgres via Prisma.
# When it is UNSET, the app uses a local JSON file (data/menu.local.json) so it
# runs with zero setup — great for local development.
#
# On Vercel: add a Postgres store (Storage tab) and these are provided for you.
# DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgres://user:pass@host/db?sslmode=require"   # optional, for migrations/pooling

# ─── Footer contact links (optional, safe to expose) ───
# Shown as icon buttons at the end of the menu. Any left unset render as a
# non-linking placeholder icon.
# NEXT_PUBLIC_MAP_URL="https://maps.google.com/?q=Your+Restaurant"
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourhandle"
# NEXT_PUBLIC_WHATSAPP_PHONE="+968XXXXXXXX"   # or set a full wa.me URL below
# NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/968XXXXXXXX"

# ─── Image storage (production) ───
# When BLOB_READ_WRITE_TOKEN is set, uploaded dish images go to Vercel Blob.
# When it is UNSET, images are written to /public/uploads (local dev only).
# On Vercel: add a Blob store (Storage tab) and this is provided for you.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
