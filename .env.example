# ─────────────────────────────────────────────────────────────
# RestMenu environment variables
# Copy to `.env` for local dev, or set these in your host's dashboard
# (Netlify / Vercel → Environment variables).
#
# Branding (name, logo, colours, contact links) lives in code, in
# src/brand.config.ts — not here. These are secrets + infrastructure only.
# ─────────────────────────────────────────────────────────────

# Admin panel password (owner logs in at /admin).
# Local dev falls back to "admin" if unset — always set a real one in production.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Use a long random string:
#   openssl rand -base64 32
SESSION_SECRET="generate-a-long-random-string"

# ─── Database (production) ───
# With DATABASE_URL set → Postgres via Prisma. Unset → local JSON file (dev).
# Recommended free option: Neon (https://neon.tech). Also auto-detected:
# POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING (Vercel), DATABASE_URL_UNPOOLED (Neon).
# DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgres://user:pass@host/db?sslmode=require"   # optional (migrations)

# ─── Image storage (production) ───
# Uploaded dish images. Pick ONE. Unset → local /public/uploads (dev only).
#
# Option A (recommended, free): S3-compatible — Cloudflare R2 / Supabase / Backblaze.
# S3_BUCKET="restmenu-clientname"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # R2 endpoint
# S3_REGION="auto"                                              # "auto" for R2
# S3_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"                  # public bucket URL / CDN domain
# S3_FORCE_PATH_STYLE="false"
#
# Option B: Vercel Blob (only if hosting on Vercel).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ─── One-time menu import (optional) ───
# Set to 1 for a single deploy to WIPE and reload the menu from code
# (see scripts/db-setup.mjs). Remove it afterwards.
# IMPORT_MENU="0"

# ─── Ordering / POS (optional) ───
# Turn table-QR ordering on per client in src/brand.config.ts (features.ordering).
# Ordering works with no POS (orders show in /admin/orders). To connect a POS,
# implement an adapter in src/lib/pos and register it, then set:
# POS_PROVIDER="foodics"
# POS_API_KEY="..."

# ─── Footer contact links (optional; overrides src/brand.config.ts) ───
# NEXT_PUBLIC_MAP_URL="https://maps.app.goo.gl/xxxx"
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourhandle"
# NEXT_PUBLIC_WHATSAPP_PHONE="+968XXXXXXXX"
